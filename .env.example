# Copie este archivo como .env y reemplace TODOS los valores "cambiar-...".
# Genere secretos con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Nunca versione el archivo .env.

# --- Entorno ---
APP_ENV=development            # development | production
APP_TIMEZONE=America/Bogota

# --- PostgreSQL (contenedor) ---
POSTGRES_SUPERUSER_PASSWORD=cambiar-superusuario
APP_DB_NAME=inventario
APP_TEST_DB_NAME=inventario_test   # dejar vacío en producción
APP_OWNER_PASSWORD=cambiar-owner
APP_USER_PASSWORD=cambiar-app-user

# Puerto local solo para desarrollo (enlazado a 127.0.0.1, nunca a internet)
DB_DEV_PORT=55432

# --- Sesiones ---
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# --- Autenticación: límite de intentos ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- CORS: vacío = mismo origen únicamente (recomendado) ---
CORS_ORIGINS=

# --- Producción ---
PUBLIC_DOMAIN=inventario.ejemplo.com
ACME_EMAIL=admin@ejemplo.com

# --- Precios de mercado (SIPSA) ---
MARKET_SYNC_HOUR=15
MARKET_SYNC_MINUTE=30
SIPSA_URL=https://appweb.dane.gov.co/sipsaWS/SrvSipsaUpraBeanService
